	column discounted_price = sales[price] *(1 - sales[sale_discount])
		lineageTag: 6e08cb09-c5e8-4585-bf7b-83578a547314
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column bulk_order = IF(sales[sale_quantity] > 3, TRUE(), FALSE() )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 496f3526-3066-4a25-bbb7-a0f2bd04a6da
		summarizeBy: none

