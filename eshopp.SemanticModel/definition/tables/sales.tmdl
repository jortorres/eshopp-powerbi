	column order_size = ```
			SWITCH(TRUE, sales[discounted_price] < 100, "Tiny", sales[discounted_price] < 200, "Mid", "Massive") 
			```
		lineageTag: 4bfe1e7e-d1c2-44aa-91bb-170bd4acf08b
