table sales
	lineageTag: 5e5740c1-50df-4cd8-9e0e-884263a2663e

	measure total_revenue = SUM(sales[discounted_price])
		lineageTag: 0d5a6755-dc05-4240-867a-1c4ea451fe9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure total_units_sold = ```
			SUM(sales[sale_quantity]) 
			```
		formatString: 0
		lineageTag: 4b76f461-8277-4525-91f0-309d8ef63794

	measure revenue_in_feb = CALCULATE([total_revenue], DATESBETWEEN(dates[date], DATE(2025,02,01),DATE(2025,02,28)))
		lineageTag: 8394701b-767f-462e-9f9c-d615fde0b4f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

